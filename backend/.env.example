# --- Chain ---
RPC_URL=http://127.0.0.1:8545
# RPC URL shown to browsers for the demo wallets (only matters when it differs from RPC_URL, e.g. in Docker)
# PUBLIC_RPC_URL=http://127.0.0.1:8545
DEPLOYMENT_FILE=../deployments/localhost.json

# --- Verifier signing key ---
# Defaults to Hardhat account #1 for LOCAL DEVELOPMENT ONLY. For any public network generate your own:
#   python scripts/gen_verifier_key.py
VERIFIER_PRIVATE_KEY=

# --- Evidence source ---
# simulated = offline demo reference data (clearly labelled). sentinel2 = live Sentinel-2 NDVI
# (needs: pip install -r requirements-live.txt)
SATELLITE_PROVIDER=simulated

# --- Behaviour ---
# true = the API refuses to sign when the land is already claimed on-chain (saves gas). The contract enforces it either way.
REFUSE_ON_CONFLICT=false
ATTESTATION_TTL_SECONDS=3600
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional ---
# ANTHROPIC_API_KEY=      # lets Claude write the plain-language explanation. It never changes the decision.
# PINATA_JWT=             # pins evidence bundles to IPFS and uses ipfs:// metadata URIs
